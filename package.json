{
  "name": "resumorph",
  "version": "0.1.0",
  "description": "One resume file, many shapes: an open-source CV website template.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/1210910/resumorph.git"
  },
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p . && next build",
    "clean": "rm -rf build-tsc .next out",
    "dev": "next dev",
    "lint": "eslint './src/**/*.{js,jsx,ts,tsx}' --max-warnings=0 && prettier --check './src/**/*.{js,jsx,ts,tsx}'",
    "format": "prettier --write './src/**/*.{js,jsx,json,ts,tsx}' && eslint './src/**/*.{js,jsx,ts,tsx}' --fix",
    "typecheck": "tsc --noEmit -p .",
    "cv:pdf": "node scripts/cv/build-pdf.js",
    "preview": "npx serve out"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.2.0",
    "autoprefixer": "^10.6.1",
    "classnames": "^2.5.1",
    "next": "^16.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-pattern": "^5.9.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.35",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.18",
    "@types/tailwindcss": "^3.1.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "cssnano": "^6.1.2",
    "eslint": "^8.46.0",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-module-resolver": "^1.5.0",
    "eslint-plugin-monorepo": "^0.3.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-memo": "^0.0.3",
    "eslint-plugin-react-native": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "postcss": "^8.5.31",
    "postcss-preset-env": "^9.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.106.1",
    "serve": "^14.2.6",
    "sort-package-json": "^2.15.1",
    "stylelint": "^15.10.2",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^4.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "autoprefixer": "10.4.5"
  }
}
